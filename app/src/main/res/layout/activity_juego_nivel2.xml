<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/fondo2">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="NIVEL 2"
        android:textSize="28sp"

        android:textStyle="bold"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.529"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.092" />

    <TextView
        android:id="@+id/puntuacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Puntos: 0"
        android:textSize="20sp"

        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/c1"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="50dp"
        android:layout_marginStart="30dp"

        app:layout_constraintTop_toBottomOf="@id/puntuacion"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/c2"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="50dp"

        app:layout_constraintTop_toBottomOf="@id/puntuacion"
        app:layout_constraintStart_toEndOf="@id/c1"
        app:layout_constraintEnd_toStartOf="@id/c3"/>

    <ImageButton
        android:id="@+id/c3"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="50dp"
        android:layout_marginEnd="30dp"

        app:layout_constraintTop_toBottomOf="@id/puntuacion"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/c4"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"

        app:layout_constraintTop_toBottomOf="@id/c2"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/c5"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="30dp"

        app:layout_constraintTop_toBottomOf="@id/c2"
        app:layout_constraintStart_toEndOf="@id/c4"
        app:layout_constraintEnd_toStartOf="@id/c6"/>

    <ImageButton
        android:id="@+id/c6"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"

        app:layout_constraintTop_toBottomOf="@id/c3"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/c7"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="30dp"
        android:layout_marginStart="90dp"

        app:layout_constraintTop_toBottomOf="@id/c5"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/c8"
        android:layout_width="95dp"
        android:layout_height="95dp"

        android:src="@drawable/carta"

        android:layout_marginTop="30dp"
        android:layout_marginEnd="90dp"

        app:layout_constraintTop_toBottomOf="@id/c5"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnComprobar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"

        android:text="COMPROBAR"

        android:layout_marginTop="40dp"

        app:layout_constraintTop_toBottomOf="@id/c7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>