<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/fondo2">

    <Button
        android:id="@+id/btnComprobar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:text="COMPROBAR"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c13" />

    <ImageButton
        android:id="@+id/c16"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginTop="16dp"
        android:layout_marginEnd="40dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c12" />

    <ImageButton
        android:id="@+id/c2"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c1"
        app:layout_constraintTop_toBottomOf="@id/puntuacion" />

    <ImageButton
        android:id="@+id/c3"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c2"
        app:layout_constraintTop_toBottomOf="@id/puntuacion" />

    <ImageButton
        android:id="@+id/c5"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c1" />

    <ImageButton
        android:id="@+id/c6"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c5"
        app:layout_constraintTop_toBottomOf="@id/c2" />

    <ImageButton
        android:id="@+id/c7"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c6"
        app:layout_constraintTop_toBottomOf="@id/c3" />

    <ImageButton
        android:id="@+id/c8"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c4" />

    <ImageButton
        android:id="@+id/c9"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c5" />

    <ImageButton
        android:id="@+id/c10"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c9"
        app:layout_constraintTop_toBottomOf="@id/c6" />

    <ImageButton
        android:id="@+id/c12"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c8" />

    <ImageButton
        android:id="@+id/c11"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c10"
        app:layout_constraintTop_toBottomOf="@id/c7" />

    <ImageButton
        android:id="@+id/c13"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c9" />

    <ImageButton
        android:id="@+id/c4"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginTop="20dp"
        android:layout_marginEnd="40dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/puntuacion" />

    <ImageButton
        android:id="@+id/c1"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"

        android:scaleType="fitCenter"
        android:src="@drawable/carta"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/puntuacion" />

    <ImageButton
        android:id="@+id/c15"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c14"
        app:layout_constraintTop_toBottomOf="@id/c11" />

    <ImageButton
        android:id="@+id/c14"
        android:layout_width="75dp"
        android:layout_height="75dp"

        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"

        android:scaleType="fitCenter"

        android:src="@drawable/carta"
        app:layout_constraintStart_toEndOf="@id/c13"
        app:layout_constraintTop_toBottomOf="@id/c10" />

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="NIVEL 3"
        android:textSize="24sp"

        android:textStyle="bold"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.481"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.154" />

    <TextView
        android:id="@+id/puntuacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"
        android:text="Puntos: 0"

        android:textSize="18sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

</androidx.constraintlayout.widget.ConstraintLayout>