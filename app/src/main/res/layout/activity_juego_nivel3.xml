<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/fondo2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:gravity="center"

        android:padding="8dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202020"
            android:text="NIVEL 3"
            android:textSize="@dimen/level3_title_size"
            android:textStyle="bold" />

        <!-- PUNTUACIÓN -->

        <TextView
            android:id="@+id/puntuacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202020"
            android:layout_marginTop="8dp"

            android:text="Puntos: 0"
            android:textSize="@dimen/level3_score_size" />

        <!-- FILA 1 -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center"

            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/c1"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c2"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c3"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c4"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

        </LinearLayout>

        <!-- FILA 2 -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/c5"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c6"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c7"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c8"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

        </LinearLayout>

        <!-- FILA 3 -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/c9"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c10"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c11"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c12"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

        </LinearLayout>

        <!-- FILA 4 -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/c13"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c14"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c15"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

            <ImageButton
                android:id="@+id/c16"
                android:layout_width="@dimen/level3_card_size"
                android:layout_height="@dimen/level3_card_size"

                android:layout_margin="4dp"

                android:padding="0dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/carta" />

        </LinearLayout>

        <!-- BOTÓN -->

        <Button
            android:id="@+id/btnComprobar"
            android:layout_width="@dimen/level3_button_width"
            android:layout_height="wrap_content"
            android:textColor="#202020"
            android:layout_marginTop="20dp"

            android:text="COMPROBAR"
            android:textSize="@dimen/level3_button_text_size" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>